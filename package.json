{
  "name": "siteforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI website design & creation app on Cloudflare — guided interview, web-presence ingestion, generation, preview, deploy.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 migrations apply siteforge-db --local",
    "db:remote": "wrangler d1 migrations apply siteforge-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260706.1",
    "typescript": "^5.7.3",
    "vitest": "2.1.9",
    "wrangler": "^4.108.0"
  }
}
