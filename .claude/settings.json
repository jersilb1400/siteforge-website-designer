{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx wrangler deploy --dry-run:*)",
      "Bash(npx wrangler types:*)",
